---
// ProofBand.astro
---

<section class="proof-band">
  <!-- Large subtle 638 watermark in background -->
  <div class="proof-watermark" aria-hidden="true">638</div>

  <div class="shell">
    <div class="proof-content reveal">
      <div class="proof-left">
        <h2 class="proof-headline">638 avaliações não acontecem por acaso.</h2>
        <p class="proof-sub">Atendimento, estrutura, profissionais e uma experiência que fazem clientes voltarem.</p>
      </div>

      <div class="proof-score-block">
        <div class="proof-big-score">5,0</div>
        <div class="proof-stars-wrap">
          <div class="stars">★★★★★</div>
          <span>Avaliação no Google</span>
        </div>
        <a class="text-link-navy" href="#avaliacoes" style="margin-left: 12px;">
          Ver avaliações →
        </a>
      </div>
    </div>
  </div>
</section>
