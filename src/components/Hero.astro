---
// Hero.astro
import Icon from './Icon.astro';
---

<section class="hero" id="top">
  <!-- Subtle Background Official Z + Razor Watermark -->
  <div class="hero-watermark" aria-hidden="true">
    <img src="/images/logo-symbol.png" alt="" width="560" height="560" loading="eager" />
  </div>

  <!-- Warm ambient light glow -->
  <div class="hero-warm-glow" aria-hidden="true"></div>

  <div class="shell">
    <div class="hero-grid">
      <!-- Left Column: Copy & Conversions (48%) -->
      <div class="hero-copy">
        
        <!-- Warm Hospitality Tag -->
        <div class="hero-hospitality-tag">
          <span class="tag-dot"></span>
          <span>Barbearia por Assinatura em Cuiabá</span>
        </div>
        
        <h1 class="display-title hero-title">
          Seu estilo em dia.<br>
          <span class="accent-gold">Do seu jeito.</span>
        </h1>
        
        <p class="body-lead hero-lead">
          Corte, barba e uma experiência feita para quem valoriza atendimento acolhedor, pontualidade britânica e cuidado em cada detalhe. Escolha sua unidade e reserve seu horário em poucos segundos.
        </p>

        <!-- Perks list (Calor & Hospitalidade com Lucide Icons) -->
        <div class="hero-perks">
          <div class="perk-pill">
            <Icon name="coffee" size={16} class="perk-icon" />
            <span>Café Moído na Hora</span>
          </div>
          <div class="perk-pill">
            <Icon name="beer" size={16} class="perk-icon" />
            <span>Chopp Gelado</span>
          </div>
          <div class="perk-pill">
            <Icon name="scissors" size={16} class="perk-icon" />
            <span>Mestres da Navalha</span>
          </div>
        </div>

        <!-- Live Availability Micro-Badge -->
        <div class="hero-live-badge">
          <span class="live-pulse" aria-hidden="true"></span>
          <span>Horários disponíveis para hoje nas 2 unidades</span>
        </div>

        <div class="hero-actions">
          <a class="btn btn-yellow hero-main-btn" href="https://cashbarber.com.br/zangadinbarbearia" target="_blank" rel="noopener">
            <span>Agendar meu horário</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a class="text-link-yellow" href="#planos">
            Conhecer os planos →
          </a>
        </div>

        <!-- Human Social Proof -->
        <div class="hero-indicators">
          <div class="indicator-item">
            <div class="stars-gold">★★★★★</div>
            <span><strong>5,0</strong> no Google</span>
          </div>
          <div class="indicator-separator" aria-hidden="true">·</div>
          <div class="indicator-item">
            <span><strong>638</strong> clientes atendidos</span>
          </div>
          <div class="indicator-separator" aria-hidden="true">·</div>
          <div class="indicator-item">
            <span><strong>2</strong> unidades em Cuiabá</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Full-Height Indoor Atmosphere Photo (52%) -->
      <div class="hero-media">
        <div class="hero-photo-container">
          <img
            src="/images/img_1.jpg"
            alt="Ambiente acolhedor e atendimento na Zangadin Barbearia"
            width="640"
            height="768"
            loading="eager"
          />
          <div class="hero-photo-vignette" aria-hidden="true"></div>
          
          <!-- Floating Experience Card -->
          <div class="hero-floating-badge">
            <div class="floating-icon">
              <Icon name="clock" size={20} />
            </div>
            <div class="floating-text">
              <strong>Atendimento Sem Espera</strong>
              <small>Seu horário é levado a sério</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--header-height) + 40px);
    padding-bottom: 80px;
    background: radial-gradient(circle at 80% 30%, #01245C 0%, #00183F 70%);
    color: #ffffff;
    overflow: hidden;
  }

  .hero-watermark {
    position: absolute;
    right: 3%;
    top: 50%;
    bottom: auto;
    left: auto;
    transform: translateY(-50%);
    width: clamp(340px, 42vw, 620px);
    height: clamp(340px, 42vw, 620px);
    pointer-events: none;
    z-index: 1;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.045;
  }

  .hero-watermark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    transform: rotate(-4deg);
  }

  .hero-warm-glow {
    position: absolute;
    bottom: -100px;
    left: 10%;
    width: 500px;
    height: 350px;
    background: radial-gradient(circle, rgba(212, 163, 47, 0.12) 0%, rgba(1, 36, 92, 0) 70%);
    pointer-events: none;
    filter: blur(60px);
    z-index: 1;
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 48px;
    align-items: center;
  }

  .hero-copy,
  .hero-media {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 960px) {
    .hero {
      padding-top: calc(var(--header-height) + 20px);
      padding-bottom: 60px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .hero-hospitality-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(246, 196, 16, 0.12);
    border: 1px solid rgba(246, 196, 16, 0.3);
    padding: 6px 14px;
    border-radius: 50px;
    color: var(--yellow-main);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    background: var(--yellow-main);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--yellow-main);
  }

  .hero-title {
    font-size: clamp(2.3rem, 4.2vw, 3.6rem);
    line-height: 1.08;
    margin-bottom: 18px;
    color: #ffffff;
    font-weight: 800;
  }

  .accent-gold {
    color: var(--yellow-main);
    position: relative;
    display: inline-block;
  }

  .hero-lead {
    font-size: 1.05rem;
    color: #cbd5e1;
    line-height: 1.65;
    margin-bottom: 24px;
    max-width: 520px;
  }

  .hero-perks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }

  .perk-pill {
    font-size: 0.82rem;
    font-weight: 600;
    color: #e2e8f0;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 7px 14px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .perk-icon {
    color: var(--yellow-main);
    flex-shrink: 0;
  }

  .hero-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #4ade80;
    margin-bottom: 22px;
    background: rgba(74, 222, 128, 0.08);
    border: 1px solid rgba(74, 222, 128, 0.22);
    padding: 6px 14px;
    border-radius: 50px;
    width: fit-content;
  }

  .live-pulse {
    width: 7px;
    height: 7px;
    background: #4ade80;
    border-radius: 50%;
    box-shadow: 0 0 8px #4ade80;
    animation: livePulseAnim 2s infinite ease-in-out;
    flex-shrink: 0;
  }

  @keyframes livePulseAnim {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .hero-main-btn {
    padding: 16px 32px;
    font-size: 0.92rem;
  }

  .btn-arrow {
    transition: transform var(--transition-fast);
  }

  .hero-main-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  .hero-indicators {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.88rem;
    color: #94a3b8;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stars-gold {
    color: var(--yellow-main);
    letter-spacing: 2px;
    display: inline-block;
    margin-right: 4px;
  }

  .indicator-item strong {
    color: #ffffff;
  }

  .indicator-separator {
    color: rgba(255, 255, 255, 0.25);
  }

  /* Photo Container with Organic Depth */
  .hero-photo-container {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1);
    background: var(--navy-main);
  }

  .hero-photo-container img {
    width: 100%;
    height: 100%;
    max-height: 580px;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-photo-container:hover img {
    transform: scale(1.02);
  }

  .hero-photo-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 24, 63, 0.1) 0%, rgba(0, 24, 63, 0.6) 100%);
    pointer-events: none;
  }

  .hero-floating-badge {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(0, 24, 63, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(246, 196, 16, 0.35);
    border-radius: 4px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .floating-icon {
    color: var(--yellow-main);
    background: rgba(246, 196, 16, 0.15);
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .floating-text strong {
    display: block;
    color: #ffffff;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .floating-text small {
    color: #cbd5e1;
    font-size: 0.78rem;
  }

  @media (max-width: 640px) {
    .hero-watermark {
      display: none;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }

    .hero-main-btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }

    .text-link-yellow {
      justify-content: center;
    }

    .hero-photo-container img {
      max-height: 380px;
    }

    .hero-floating-badge {
      left: 12px;
      right: 12px;
      bottom: 12px;
      padding: 10px 12px;
      gap: 10px;
    }

    .floating-icon {
      width: 36px;
      height: 36px;
    }

    .floating-text strong {
      font-size: 0.84rem;
    }

    .floating-text small {
      font-size: 0.72rem;
    }

    .hero-indicators {
      gap: 8px 10px;
      font-size: 0.8rem;
    }
  }
</style>
