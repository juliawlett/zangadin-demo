---
// Gallery.astro (Ambiente)
---

<section class="ambient-sec" id="ambiente">
  <div class="shell">
    <div class="ambient-head reveal">
      <div class="eyebrow eyebrow-yellow">Por Dentro da Zangadin</div>
      <h2 class="display-title section-title">Entre. Sente. Deixe o resto com a gente.</h2>
      <p class="body-lead">
        Um ambiente pensado para você desacelerar por alguns minutos enquanto profissionais cuidam do seu visual com excelência.
      </p>
    </div>

    <div class="ambient-grid reveal">
      <!-- Big Salon Interior Photo -->
      <div class="ambient-photo main">
        <img
          src="/images/img_5.jpg"
          alt="Salão Zangadin Barbearia"
          width="720"
          height="480"
          loading="lazy"
        />
        <div class="ambient-overlay-text">
          Conforto · Estrutura · Atendimento
        </div>
      </div>

      <!-- Facade Photo -->
      <div class="ambient-photo">
        <img
          src="/images/img_4.jpg"
          alt="Fachada Zangadin Barbearia"
          width="480"
          height="320"
          loading="lazy"
        />
        <div class="ambient-overlay-text">
          Presença &amp; Tradição em Cuiabá
        </div>
      </div>

      <!-- Grooming Detail Photo -->
      <div class="ambient-photo">
        <img
          src="/images/img_2.jpg"
          alt="Cuidado com os detalhes"
          width="480"
          height="320"
          loading="lazy"
        />
        <div class="ambient-overlay-text">
          Tudo no lugar para você sair do jeito que queria
        </div>
      </div>
    </div>
  </div>
</section>