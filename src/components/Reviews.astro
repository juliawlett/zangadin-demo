---
// Reviews.astro - Social Proof & Symmetrical Masters Team Showcase
import Icon from './Icon.astro';

const barbers = [
  {
    name: 'Paulo',
    role: 'Mestre Barbeiro',
    specialty: 'Especialista em Degradê & Fade',
    unit: 'Unidade Beira Rio',
    rating: '5.0 ★',
    image: '/images/img_6.jpg', // Campo para foto do profissional
    scheduleUrl: 'https://cashbarber.com.br/zangadinbarbearia'
  },
  {
    name: 'Daniel',
    role: 'Mestre da Navalha',
    specialty: 'Barba Terapia & Toalha Quente',
    unit: 'Unidade Jardim Imperial',
    rating: '5.0 ★',
    image: '/images/img_2.jpg', // Campo para foto do profissional
    scheduleUrl: 'https://cashbarber.com.br/zangadinbarbearia'
  },
  {
    name: 'Isaque',
    role: 'Visagista & Estilo',
    specialty: 'Alinhamento & Cortes Modernos',
    unit: 'Unidade Beira Rio',
    rating: '5.0 ★',
    image: '', // Campo para futura foto (exibe moldura padrão estilizada)
    scheduleUrl: 'https://cashbarber.com.br/zangadinbarbearia'
  },
  {
    name: 'Cleiton',
    role: 'Mestre em Acabamento',
    specialty: 'Design de Barba & Finalização',
    unit: 'Unidade Jardim Imperial',
    rating: '5.0 ★',
    image: '', // Campo para futura foto (exibe moldura padrão estilizada)
    scheduleUrl: 'https://cashbarber.com.br/zangadinbarbearia'
  }
];
---

<section class="reviews-sec" id="avaliacoes">
  <div class="reviews-warm-glow" aria-hidden="true"></div>

  <div class="shell">
    <div class="reviews-head reveal">
      <div class="head-copy">
        <div class="eyebrow eyebrow-yellow">QUEM FREQUENTA RECOMENDA</div>
        <h2 class="display-title section-title">638 motivos para confiar no nosso trabalho.</h2>
        <p class="body-lead" style="color: #cbd5e1; max-width: 860px;">
          Veja o que nossos clientes dizem espontaneamente no Google sobre nossa pontualidade, atendimento e ambiente.
        </p>
      </div>

      <!-- Google Official Score Badge -->
      <div class="google-official-badge">
        <div class="google-icon-wrap">
          <svg width="24" height="24" viewBox="0 0 24 24">
            <path fill="#EA4335" d="M12 5c1.56 0 2.97.57 4.08 1.51l3.06-3.06C17.29 1.7 14.82 1 12 1 7.42 1 3.53 3.61 1.63 7.38l3.68 2.85C6.19 7.42 8.87 5 12 5z"/>
            <path fill="#4285F4" d="M23.49 12.28c0-.79-.07-1.54-.19-2.28H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58l3.68 2.86c2.14-1.98 3.74-4.89 3.74-8.67z"/>
            <path fill="#FBBC05" d="M5.31 14.77c-.24-.72-.38-1.49-.38-2.27s.14-1.55.38-2.27L1.63 7.38C.6 9.44 0 11.67 0 12c0 .33.6 2.56 1.63 4.62l3.68-2.85z"/>
            <path fill="#34A853" d="M12 23c3.24 0 5.95-1.08 7.93-2.91l-3.68-2.86c-1.08.72-2.45 1.16-4.25 1.16-3.13 0-5.81-2.42-6.69-5.23L1.63 16.01C3.53 19.78 7.42 22.4 12 22.4z"/>
          </svg>
        </div>
        <div class="badge-content">
          <div class="score-row">
            <span class="score-number">5.0</span>
            <span class="score-stars">★★★★★</span>
          </div>
          <span class="score-label">638 avaliações verificadas no Google</span>
        </div>
      </div>
    </div>

    <!-- 3 Human Editorial Testimonial Cards -->
    <div class="reviews-cards-grid reveal stagger">
      <!-- Review 1 -->
      <div class="review-item">
        <div class="quote-mark" aria-hidden="true">“</div>
        <p class="review-body">
          Cortes, atendimento, espaço, localização, tudo de altíssima qualidade. O ambiente é extremamente agradável e você é atendido rigorosamente no horário marcado.
        </p>
        <div class="reviewer-footer">
          <div class="reviewer-avatar">R</div>
          <div class="reviewer-meta">
            <strong>Rodrigo Santana</strong>
            <span>Cliente Assinante · Unidade Beira Rio</span>
          </div>
          <div class="verified-tag">✓ Verificado</div>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="review-item">
        <div class="quote-mark" aria-hidden="true">“</div>
        <p class="review-body">
          Excelentes profissionais e atendimento impecável. O café de recepção é ótimo e o cuidado técnico no corte e na barba é visível. Não troco por nenhuma outra em Cuiabá.
        </p>
        <div class="reviewer-footer">
          <div class="reviewer-avatar">M</div>
          <div class="reviewer-meta">
            <strong>Matheus Alencar</strong>
            <span>Cliente Assinante · Unidade Jardim Imperial</span>
          </div>
          <div class="verified-tag">✓ Verificado</div>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="review-item">
        <div class="quote-mark" aria-hidden="true">“</div>
        <p class="review-body">
          O grande diferencial está no cuidado com os detalhes. Pontualidade britânica, produtos de primeira linha e um padrão de acabamento que não se encontra fácil.
        </p>
        <div class="reviewer-footer">
          <div class="reviewer-avatar">C</div>
          <div class="reviewer-meta">
            <strong>Dr. Carlos Eduardo</strong>
            <span>Cliente Assinante · Unidade Beira Rio</span>
          </div>
          <div class="verified-tag">✓ Verificado</div>
        </div>
      </div>
    </div>

    <!-- Symmetrical Masters Team Section with Image Slots (Equipe de Mestres) -->
    <div class="masters-team-sec reveal">
      <div class="masters-header-row">
        <div class="masters-title-wrap">
          <span class="masters-eyebrow">EQUIPE DE MESTRES</span>
          <h3 class="masters-main-title">Profissionais que viram referência para seus clientes</h3>
          <p class="masters-subtitle">
            Barbeiros especialistas reconhecidos nominalmente pelas centenas de avaliações 5 estrelas.
          </p>
        </div>
        <a class="btn btn-outline-white staff-btn" href="https://maps.app.goo.gl/uUA4qgW9KJfWXVfR8" target="_blank" rel="noopener">
          <span>Ver no Google Maps</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- 4 Symmetrical Columns Grid -->
      <div class="masters-grid">
        {barbers.map((barber) => (
          <div class="master-card">
            <!-- Image Frame / Photo Slot -->
            <div class="master-photo-frame">
              {barber.image ? (
                <img 
                  src={barber.image} 
                  alt={`Barbeiro ${barber.name} - Zangadin Barbearia`}
                  width="300"
                  height="340"
                  loading="lazy"
                  class="master-img"
                />
              ) : (
                <div class="master-photo-placeholder">
                  <div class="placeholder-icon">
                    <Icon name="scissors" size={28} />
                  </div>
                  <span class="placeholder-monogram">{barber.name.charAt(0)}</span>
                </div>
              )}

              <div class="master-rating-tag">{barber.rating}</div>
              <div class="master-unit-pill">{barber.unit}</div>
            </div>

            <!-- Master Info Block -->
            <div class="master-content">
              <div class="master-header">
                <h4 class="master-name">{barber.name}</h4>
                <span class="master-role">{barber.role}</span>
              </div>

              <p class="master-specialty">{barber.specialty}</p>

              <a 
                href={barber.scheduleUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="master-book-btn"
                aria-label={`Agendar horário com ${barber.name}`}
              >
                <span>Agendar com {barber.name}</span>
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-sec {
    background: radial-gradient(circle at 20% 50%, #01245C 0%, #00183F 100%);
    color: #ffffff;
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }

  .reviews-warm-glow {
    position: absolute;
    top: 20%;
    right: 5%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(246, 196, 16, 0.08) 0%, rgba(0, 24, 63, 0) 70%);
    pointer-events: none;
    filter: blur(50px);
  }

  .reviews-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .google-official-badge {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .google-icon-wrap {
    background: #ffffff;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .score-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .score-number {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 900;
    color: #ffffff;
  }

  .score-stars {
    color: var(--yellow-main);
    letter-spacing: 2px;
    font-size: 1.1rem;
  }

  .score-label {
    display: block;
    font-size: 0.76rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .reviews-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 64px;
  }

  @media (max-width: 960px) {
    .reviews-cards-grid {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 48px;
    }
  }

  .review-item {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 32px 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: all var(--transition-normal);
  }

  .review-item:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(246, 196, 16, 0.4);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .quote-mark {
    font-family: serif;
    font-size: 3.5rem;
    color: var(--yellow-main);
    line-height: 1;
    margin-bottom: -10px;
    opacity: 0.8;
  }

  .review-body {
    font-size: 0.98rem;
    color: #e2e8f0;
    line-height: 1.65;
    margin-bottom: 24px;
    font-style: italic;
  }

  .reviewer-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .reviewer-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--yellow-main);
    color: var(--navy-deep);
    font-family: var(--font-heading);
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .reviewer-meta {
    flex: 1;
  }

  .reviewer-meta strong {
    display: block;
    font-size: 0.92rem;
    color: #ffffff;
  }

  .reviewer-meta span {
    display: block;
    font-size: 0.76rem;
    color: #94a3b8;
  }

  .verified-tag {
    font-size: 0.72rem;
    color: #22c55e;
    font-weight: 700;
    white-space: nowrap;
  }

  /* ==========================================================================
     EQUIPE DE MESTRES — Symmetrical 4-Columns Grid with Image Ready Slots
     ========================================================================== */
  .masters-team-sec {
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 44px 36px;
    position: relative;
  }

  @media (max-width: 768px) {
    .masters-team-sec {
      padding: 30px 20px;
    }
  }

  .masters-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  .masters-eyebrow {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--yellow-main);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
  }

  .masters-main-title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: #ffffff;
    font-weight: 800;
    margin-bottom: 6px;
  }

  .masters-subtitle {
    font-size: 0.9rem;
    color: #94a3b8;
    margin: 0;
    max-width: 600px;
  }

  /* 4 Symmetrical Columns Grid */
  .masters-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 1100px) {
    .masters-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 580px) {
    .masters-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .master-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .master-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(246, 196, 16, 0.45);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
  }

  /* Photo Frame Slot */
  .master-photo-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 4.2;
    background: rgba(1, 36, 92, 0.5);
    overflow: hidden;
  }

  .master-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease);
  }

  .master-card:hover .master-img {
    transform: scale(1.05);
  }

  .master-photo-placeholder {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 40%, rgba(246, 196, 16, 0.12) 0%, rgba(1, 36, 92, 0.6) 80%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .placeholder-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(246, 196, 16, 0.15);
    color: var(--yellow-main);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-monogram {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.4);
    line-height: 1;
  }

  .master-rating-tag {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(0, 24, 63, 0.85);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(246, 196, 16, 0.35);
    color: var(--yellow-main);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .master-unit-pill {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    color: #e2e8f0;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  /* Master Info */
  .master-content {
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
    gap: 14px;
  }

  .master-header {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .master-name {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .master-role {
    font-size: 0.76rem;
    color: var(--yellow-main);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .master-specialty {
    font-size: 0.82rem;
    color: #cbd5e1;
    line-height: 1.45;
    margin: 0;
    min-height: 36px;
  }

  .master-book-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .master-book-btn:hover {
    background: var(--yellow-main);
    color: var(--navy-deep);
    border-color: var(--yellow-main);
    transform: translateY(-1px);
  }

  .master-book-btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  .btn-arrow {
    transition: transform var(--transition-fast);
    font-weight: 800;
  }
</style>