<div class="mobile-action-bar" id="mobile-bar" aria-label="Ações rápidas no celular">
  <a 
    href="https://wa.me/5565999999999?text=Ol%C3%A1%2C%20gostaria%20de%20informa%C3%A7%C3%B5es%20sobre%20a%20Zangadin" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="bar-btn bar-whatsapp"
    aria-label="Falar no WhatsApp"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <span>WhatsApp</span>
  </a>

  <a 
    href="https://cashbarber.com.br/zangadinbarbearia" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="bar-btn bar-primary"
    aria-label="Agendar horário na Zangadin Barbearia"
  >
    <span>Agendar horário</span>
    <span class="btn-arrow" aria-hidden="true">→</span>
  </a>
</div>

<style>
  .mobile-action-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 990;
    padding: 12px 16px;
    background: rgba(0, 15, 40, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.4);
    gap: 10px;
    align-items: center;
  }

  @media (max-width: 768px) {
    .mobile-action-bar {
      display: flex;
    }
    
    /* Give space at bottom of document on mobile so footer content isn't covered */
    :global(body) {
      padding-bottom: 76px;
    }
  }

  .bar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 48px;
    border-radius: 4px;
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .bar-whatsapp {
    flex: 0 0 35%;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .bar-whatsapp:hover,
  .bar-whatsapp:active {
    background: rgba(37, 211, 102, 0.2);
    color: #25D366;
    border-color: #25D366;
  }

  .bar-primary {
    flex: 1 1 65%;
    background: var(--yellow-main);
    color: var(--navy-deep);
    border: 1px solid var(--yellow-main);
    font-weight: 800;
    box-shadow: 0 4px 14px rgba(246, 196, 16, 0.25);
  }

  .bar-primary:hover,
  .bar-primary:active {
    background: #e5b60e;
    transform: translateY(-1px);
  }

  .btn-arrow {
    font-weight: 800;
    transition: transform var(--transition-fast);
  }

  .bar-primary:hover .btn-arrow {
    transform: translateX(3px);
  }
</style>